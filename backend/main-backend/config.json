{
  "server": {
    "serverPort": "4000",
    "databaseUrl": "postgres://geoip:geoip_secret@postgres:5432/geoip?sslmode=disable",
    "reportsDir": "/app/backend/reports",
    "cookieSecure": false,
    "sessionTtlHours": 720,
    "guestLimit": 3,
    "guestCacheMaxItems": 10000,
    "guestCacheTTLMinutes": 1440,
    "workerSecret": "change-me-worker-secret",
    "allowedOrigins": ["http://localhost", "http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8080", "http://127.0.0.1:8080"],
    "workers": [
      { "url": "http://crawler-worker-1:3000", "maxLoad": 1 },
      { "url": "http://crawler-worker-2:3000", "maxLoad": 1 },
      { "url": "http://crawler-worker-3:3000", "maxLoad": 1 }
    ]
  }
}
