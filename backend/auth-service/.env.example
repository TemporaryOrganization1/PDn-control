# Server
AUTH_SERVER_PORT=8081
APP_ENV=development

# PostgreSQL (uses the same geoip database as other services)
AUTH_DB_HOST=postgres
AUTH_DB_PORT=5432
AUTH_DB_USER=geoip
AUTH_DB_PASSWORD=geoip_secret
AUTH_DB_NAME=geoip

# JWT
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=168h

# SMTP (Email) — not used yet, reserved for future use
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@pdn-control.com

# Verification
VERIFICATION_BASE_URL=http://localhost:8081/api/v1/auth/verify
VERIFICATION_TOKEN_TTL=24h