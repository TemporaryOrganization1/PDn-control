# Sanitized example configuration for local Docker Compose runs.
# Copy this file to .env and replace placeholder values locally or on the server.

# Required for AI-assisted crawler checks.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key

# Shared secret used by crawler workers when reporting progress to main-backend.
WORKER_SECRET=replace-with-a-long-random-secret

# Public URL used in generated links, for example email verification links.
# Local: http://localhost
# Production: https://your-domain.example
APP_BASE_URL=http://localhost

# Public domain handled by the frontend nginx container.
# Use "_" for local/default nginx matching, or your real domain in production.
SERVER_NAME=_

# Set to true only when the frontend container has valid TLS certificates mounted.
ENABLE_HTTPS=false

# Public host ports exposed by the frontend nginx container.
HTTP_PORT=80
HTTPS_PORT=443

# Optional upload/body limit passed to nginx.
CLIENT_MAX_BODY_SIZE=25m

# TLS certificate settings for production.
# Defaults are derived from SERVER_NAME when ENABLE_HTTPS=true:
# /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem
# /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem
# Local default can be a Docker named volume. On production, use /etc/letsencrypt
# or another host directory containing the certificate files.
LETSENCRYPT_DIR=pdn-letsencrypt
SSL_CERTIFICATE=
SSL_CERTIFICATE_KEY=

# Set to true only when requests reach the app through HTTPS.
COOKIE_SECURE=false

# Authentication and guest-check limits.
SESSION_TTL_HOURS=720
GUEST_LIMIT=3

# Comma-separated frontend origins allowed to call the backend directly in dev/custom deployments.
# When using the bundled frontend nginx proxy, browser requests are same-origin via /api.
# For production, include APP_BASE_URL here if the backend is exposed directly.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional override. The default Docker Compose value points to the bundled postgres service.
DATABASE_URL=postgres://geoip:geoip_secret@postgres:5432/geoip?sslmode=disable

# Optional PDF/report output directory override for main-backend.
REPORTS_DIR=/app/backend/reports

# Optional SMTP settings for email verification. Leave blank to disable outgoing email.
# Yandex STARTTLS example: SMTP_HOST=smtp.yandex.ru and SMTP_PORT=587.
# If IPv4 SMTP is blocked but IPv6 works, set COMPOSE_PROFILES=smtp-ipv6
# and use the proxy values shown below.
COMPOSE_PROFILES=
SMTP_HOST=
SMTP_PORT=
# Optional override for TLS/AUTH name when SMTP_HOST points to a local proxy.
SMTP_SERVER_NAME=
# Optional dial network: tcp, tcp4, or tcp6. Leave blank for tcp.
SMTP_NETWORK=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional host-network SMTP IPv4-to-IPv6 proxy settings.
SMTP_IPV6_PROXY_BIND=172.18.0.1
SMTP_IPV6_PROXY_PORT=1587
SMTP_IPV6_PROXY_TARGET_HOST=smtp.yandex.ru
SMTP_IPV6_PROXY_TARGET_PORT=587
