# Sanitized example configuration for local Docker Compose runs.
# Copy this file to .env and replace placeholder values locally or on the server.

# Required for AI-assisted crawler checks.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-openrouter-key

# Shared secret used by crawler workers when reporting progress to main-backend.
WORKER_SECRET=replace-with-a-long-random-secret

# Set to true only when requests reach the app through HTTPS.
COOKIE_SECURE=false

# Authentication and guest-check limits.
SESSION_TTL_HOURS=720
GUEST_LIMIT=3

# Comma-separated frontend origins allowed to call the backend directly in dev/custom deployments.
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# Optional override. The default Docker Compose value points to the bundled postgres service.
DATABASE_URL=postgres://geoip:geoip_secret@postgres:5432/geoip?sslmode=disable

# Optional PDF/report output directory override for main-backend.
REPORTS_DIR=/app/backend/reports

# Optional SMTP settings for email verification. Leave blank to disable outgoing email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# Optional frontend build argument reserved for deployment-specific nginx config selection.
NGINX_CONFIG=
